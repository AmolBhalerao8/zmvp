# Google Cloud SQL PostgreSQL. Add ?sslmode=require when your instance requires TLS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zol?schema=public&connection_limit=10&pool_timeout=20&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/zol?schema=public&sslmode=require"

AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_URL="http://localhost:3000"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Demo integrations
MESSAGING_PROVIDER="mock"
STORAGE_PROVIDER="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
